[Unit]
Description=VFINX vs trend report, Tue-Sat 02:12 (uses the previous trading day's close)

[Timer]
OnCalendar=Tue..Sat *-*-* 02:12:00
# no LLM involved and it takes seconds: a run missed while the laptop was off is made at the next boot
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
